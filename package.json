{
  "name": "ecomer-users-admin",
  "private": true,
  "type": "module",
  "scripts": {
    "emulators": "firebase emulators:start --project demo-ecomer --only auth,firestore,functions --import=.emulator-users --export-on-exit=.emulator-users",
    "emulators:fresh": "firebase emulators:start --project demo-ecomer --only auth,firestore,functions",
    "seed:admin": "node scripts/seed_emulator.mjs",
    "test:backend": "firebase emulators:exec --project demo-ecomer-users-test --config firebase.rules-test.json --only auth,firestore,functions \"node --test firebase/test/users.test.mjs\"",
    "test:web": "firebase emulators:exec --project demo-ecomer --only auth,firestore,functions \"node scripts/web_smoke.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.35.0",
    "playwright": "^1.65.0"
  }
}
